# Copy this file to backend/.env (it is read automatically at start-up) or set
# the same variables in your hosting platform. Values already present in the
# real environment always win over the file.

# ---- Required before going live --------------------------------------------
# Secrets used to sign login tokens. Any long random string; if it leaks, every
# session can be forged. The server refuses to start with NODE_ENV=production
# and no JWT_SECRET, and keeps printing a warning about it until you set one.
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=production

# ---- Database ---------------------------------------------------------------
# 127.0.0.1 rather than "localhost": Node can resolve localhost to IPv6 while
# MongoDB listens on IPv4 by default, which fails with ECONNREFUSED.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=entrepreneur_network

# ---- Ports ------------------------------------------------------------------
PORT=4000

# ---- Only if the API also serves the built site -----------------------------
# Absolute path to frontend/dist (the output of `npm run build` in frontend/).
# Unset = the API serves only /api, exactly as in local development.
# SERVE_FRONTEND=./frontend/dist

# ---- Only if the site is served from a different origin ---------------------
# Comma-separated list of front-end origins allowed to call the API.
# Unset = no restriction (the behaviour every local run already has).
# ALLOWED_ORIGINS=https://venturelink.example.com
# FRONTEND_URL=https://venturelink.example.com

# ---- Google sign-in ---------------------------------------------------------
# With both set, the real OAuth flow is used. Without them the built-in demo
# consent screen runs, so sign-in stays demonstrable offline.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# ---- Password reset mail ----------------------------------------------------
# The reset code is returned by the API only while no mail provider is
# configured; setting any value here stops that (see README → deployment).
# MAIL_PROVIDER=ses

# ---- Outward alerts: email, SMS, WhatsApp -----------------------------------
# Everything the platform sends out (verification codes, sign-in notices, offer
# letters, filed agreements, meetings, webinar invites) goes through one of these.
# All of them are optional: with no key set, every message is still written in
# full to the delivery log (`outbox`) with status "queued" and the reason, and
# the in-app notification behaves exactly as before. Add a key and the very same
# message becomes "sent" — no code change, no new npm dependency.
#
# Email — choose ONE (checked in this order):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=alerts.yourdomain.com
#
# SMS and WhatsApp — Twilio, needs both lines; each channel then also needs its
# own sender number (a Twilio sandbox number works for testing).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SMS_FROM=+15005550006
# TWILIO_WHATSAPP_FROM=+14155238886
#
# How the sender looks to the member:
# ALERT_EMAIL_FROM=VentureLink <alerts@yourdomain.com>
# ALERT_FROM_NAME=VentureLink
